rp": "", "upd": "2026-07-31 23:44:02", "pending": []}, "1905088935900111090": {"theme": "", "kiri": "", "ins": "", "fm": "1", "hold": "", "aim": "", "log": "", "memo": "", "rp": "", "upd": "2026-07-31 23:44:09", "pending": []}}, "globals": [{"id": "g3", "text": "いいね:ブックマーク＝10:8がきれいな伸び。ほぼ同数なら企画自体が伸びづらく、いいね過多（6:4以下）は「今すぐ使える系」のジャンク有益に寄っているサイン", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g4", "text": "伸びは絶対値でなく、そのネタの期待値に対して評価する。実践者しか辿り着かないテーマなら77いいねでも成功", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g5", "text": "同じいいね数でも「いいね欄の層」で価値が変わる。強い人（経営者・実務者）が並ぶ投稿は数字が小さくても採用・人脈面で価値がある", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g6", "text": "初動で良し悪しを決めない（後伸びする投稿がある）。投稿時間は伸びに関係ない", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g7", "text": "結局「切り口ゲー」。どのニーズを掬うかを外さなければ文章が多少雑でも伸びるし、外せば綺麗に書いても伸びない", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g8", "text": "広いニーズ×アンサーが伸びる。狭い掛け算（既にやっている人がさらに、系）は切り口が面白くても伸びない", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g9", "text": "切り口は「考えるもの」ではなく「探すもの」。伸びてる実例から当たっている要素を抜き、崩さないまま具体だけ別の具体に差し替える", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g10", "text": "最重要リファレンスは自分の過去の伸びた投稿。X以外（本・YouTube）からテーマを取るとニーズがずれて伸びない", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g11", "text": "冒頭1〜2行でほぼ決まる。「2割わかる・8割どういうことだろう」の入口にして答え合わせをさせる", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g12", "text": "アハ（常識へのアンチパターン）が最低1個要る。みんながすでに知っていることは伸びない", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g13", "text": "抽象論で終わらせず、読者が自分の仕事・体験で再現できる具体まで落とす", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g14", "text": "表層はマスに分かるテーマで入り、後半にガチ勢しか分からない要素を1つ置く（バズとファン化の両立）", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g15", "text": "断定するのはフックと締めだけ。本文中の因果の決めつけはアンチ・反論リプを呼ぶ", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g16", "text": "検証できないことは書かない。「競合より高い」ではなく「いつもより高い」に落とす", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g17", "text": "Xは擦らないと成立しない。同じ話を擦り続けるのが正解で、飽きて隣のテーマにずらすと伸びない", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g18", "text": "テーマ＝そのアカウントへの期待値。いつもの発信軸と違うチャレンジ枠は当たりにくい", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g19", "text": "本文に外部リンクを置くとインプが下がる。とがりのない画像はむしろマイナスになる", "scope": "普遍", "src": "", "created": "2026-07-29 19:03:37"}, {"id": "g1", "text": "「バズりたい・伸ばしたい」はニーズとして浅い。読者の悩みの一段手前（得意ジャンルがない・発信の仕方が分からない）を掬う", "scope": "固有", "src": "", "created": "2026-07-29 19:03:29"}, {"id": "g2", "text": "胡散臭いこと・金くさいことは言わない。フォロワーは増えても入ってくる人の質が落ちる", "scope": "固有", "src": "", "created": "2026-07-29 19:03:29"}], "dupes": {"2019416456665133559": {"g": "d1", "label": "", "base": "1478", "src": ""}, "2019416593965674740": {"g": "d1", "label": "#1478+", "base": "1478", "src": "text"}, "1955882068141072792": {"g": "d2", "label": "", "base": "1254", "src": ""}, "1955982164564304151": {"g": "d2", "label": "#1254+", "base": "1254", "src": "ai"}, "1984924444423332345": {"g": "d2", "label": "#1254+", "base": "1254", "src": "text"}, "2047170691041206718": {"g": "d3", "label": "", "base": "1565", "src": ""}, "2047170779750752422": {"g": "d3", "label": "#1565+", "base": "1565", "src": "text"}, "1893569376743301521": {"g": "d4", "label": "", "base": "1021", "src": ""}, "1928603306865340651": {"g": "d4", "label": "#1021+", "base": "1021", "src": "text"}, "1955423683482452394": {"g": "d4", "label": "#1021+", "base": "1021", "src": "ai"}, "1958433137806979306": {"g": "d4", "label": "#1021+", "base": "1021", "src": "ai"}, "1970360898859774382": {"g": "d4", "label": "#1021+", "base": "1021", "src": "text"}, "1998274472412082493": {"g": "d4", "label": "#1021+", "base": "1021", "src": "text"}, "2017548116992405790": {"g": "d4", "label": "#1021+", "base": "1021", "src": "text"}, "2021155429255086484": {